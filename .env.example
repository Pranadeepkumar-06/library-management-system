# Server
NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# Database (Atlas required: transactions need a replica set)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/library_db?retryWrites=true&w=majority

# Authentication (use long random strings in production)
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=change-me-to-a-different-long-random-string
REFRESH_TOKEN_EXPIRES_IN=7d

# Frontend origin(s), comma-separated allowed
CLIENT_URL=http://localhost:5173

# Mailtrap (Email Sending API; leave API key empty for local mock log)
MAILTRAP_API_KEY=
MAILTRAP_FROM_EMAIL=
MAILTRAP_FROM_NAME=Central Library

# Optional Mailtrap Sandbox (captures mail instead of delivering)
MAILTRAP_USE_SANDBOX=false
MAILTRAP_INBOX_ID=

# Optional Cloudinary (leave empty for local disk uploads in server/uploads/)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
